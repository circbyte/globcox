{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "isVerified": { "type": "boolean" },
        "interests": { "type": "array", "items": { "type": "string" } },
        "earnings": { "type": "number" },
        "savings": { "type": "number" },
        "streak": { "type": "number" },
        "lastActive": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "email"]
    },
    "Product": {
      "title": "Product",
      "description": "Product listing",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "location": { "type": "string" },
        "category": { "type": "string" },
        "condition": { "type": "string" },
        "isDigital": { "type": "boolean" },
        "photoURL": { "type": "string" },
        "sellerId": { "type": "string" },
        "sellerName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "isSold": { "type": "boolean" }
      },
      "required": ["title", "price", "category", "sellerId", "sellerName"]
    },
    "Chat": {
      "title": "Chat",
      "description": "Chat session between users",
      "type": "object",
      "properties": {
        "participants": { "type": "array", "items": { "type": "string" } },
        "lastMessage": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "productId": { "type": "string" }
      },
      "required": ["participants", "lastMessage", "updatedAt", "productId"]
    },
    "Message": {
      "title": "Message",
      "description": "A message within a chat",
      "type": "object",
      "properties": {
        "chatId": { "type": "string" },
        "senderId": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["chatId", "senderId", "text", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "UserProfile" },
      "description": "User profiles"
    },
    "/products/{productId}": {
      "schema": { "$ref": "Product" },
      "description": "Product listings"
    },
    "/chats/{chatId}": {
      "schema": { "$ref": "Chat" },
      "description": "Chat sessions"
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": { "$ref": "Message" },
      "description": "Messages within a chat session"
    }
  }
}
