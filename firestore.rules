rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    // Collection: users
    // Fields: displayName, email, photoURL, phoneNumber, isVerified, interests, earnings, savings, streak, lastActive
    //
    // Collection: products
    // Fields: title, description, price, location, category, photoURL, sellerId, sellerName, createdAt, isSold, isDigital, lat, lng
    //
    // Collection: chats
    // Fields: participants, lastMessage, updatedAt, productId
    //
    // Collection: messages
    // Fields: chatId, senderId, text, voiceURL, createdAt
    //
    // Collection: reviews
    // Fields: reviewerId, revieweeId, rating, comment, productId, createdAt
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.uid;
    }

    function isSeller(sellerId) {
      return isAuthenticated() && request.auth.uid == sellerId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         (request.auth.token.email == "circbyte@gmail.com" && request.auth.token.email_verified == true));
    }

    function isValidUser(data) {
      return data.keys().hasAll(['displayName', 'phoneNumber']) &&
             data.displayName is string && data.displayName.size() < 100 &&
             data.phoneNumber is string && data.phoneNumber.size() < 20;
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['title', 'price', 'location', 'category', 'sellerId']) &&
             data.title is string && data.title.size() < 200 &&
             data.price is number && data.price >= 0 &&
             data.location is string && data.category is string &&
             data.sellerId == request.auth.uid;
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['chatId', 'senderId', 'text', 'createdAt']) &&
             data.senderId == request.auth.uid &&
             data.text is string && data.text.size() < 2000;
    }

    function isValidReview(data) {
      return data.keys().hasAll(['reviewerId', 'revieweeId', 'rating', 'productId']) &&
             data.reviewerId == request.auth.uid &&
             data.rating is number && data.rating >= 1 && data.rating <= 5;
    }

    // Rules
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId) && isValidUser(request.resource.data);
    }

    match /products/{productId} {
      allow read: if true; // Publicly readable for marketplace
      allow create: if isAuthenticated() && isValidProduct(request.resource.data);
      allow update: if isSeller(resource.data.sellerId) && isValidProduct(request.resource.data);
      allow delete: if isSeller(resource.data.sellerId) || isAdmin();
    }

    match /chats/{chatId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.participants;
      allow update: if isAuthenticated() && request.auth.uid in resource.data.participants;
      
      match /messages/{messageId} {
        allow read: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isAuthenticated() && isValidMessage(request.resource.data);
      }
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidReview(request.resource.data);
    }

    match /test/connection {
      allow read: if true;
    }
  }
}
