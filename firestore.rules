rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {userId}
    // Fields:
    //   - uid: string (required)
    //   - displayName: string (required)
    //   - email: string (required)
    //   - photoURL: string (optional)
    //   - isVerified: boolean (optional)
    //   - createdAt: timestamp (optional)
    //
    // Collection: products
    // Document ID: {productId}
    // Fields:
    //   - title: string (required)
    //   - description: string (optional)
    //   - price: number (required)
    //   - category: string (required)
    //   - condition: string (optional)
    //   - isDigital: boolean (optional)
    //   - photoURL: string (optional)
    //   - sellerId: string (required)
    //   - sellerName: string (required)
    //   - createdAt: timestamp (optional)
    //   - isSold: boolean (optional)
    //
    // Collection: chats
    // Document ID: {chatId}
    // Fields:
    //   - participants: list of strings (required)
    //   - lastMessage: string (required)
    //   - updatedAt: timestamp (required)
    //   - productId: string (required)
    //
    // Collection: chats/{chatId}/messages
    // Document ID: {messageId}
    // Fields:
    //   - chatId: string (required)
    //   - senderId: string (required)
    //   - text: string (required)
    //   - createdAt: timestamp (required)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function uidNotModified() {
      return !('uid' in request.resource.data) || request.resource.data.uid == resource.data.uid;
    }
    
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }
    
    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }
    
    function isValidOptionalString(field, minLen, maxLen) {
      return !(field in request.resource.data) ||
             (request.resource.data[field] is string &&
              request.resource.data[field].size() >= minLen &&
              request.resource.data[field].size() <= maxLen);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidUser(data) {
      return hasRequiredFields(['uid', 'displayName', 'email']) &&
             hasOnlyAllowedFields(['uid', 'displayName', 'email', 'photoURL', 'isVerified', 'createdAt', 'phoneNumber', 'interests', 'earnings', 'savings', 'streak', 'lastActive']) &&
             data.uid == request.auth.uid &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() < 100 &&
             data.email is string && data.email.size() >= 0 && data.email.size() < 200 &&
             isValidOptionalString('photoURL', 0, 1000) &&
             (!( 'createdAt' in data ) || data.createdAt is timestamp) &&
             (!( 'phoneNumber' in data ) || data.phoneNumber is string) &&
             (!( 'interests' in data ) || data.interests is list) &&
             (!( 'earnings' in data ) || data.earnings is number) &&
             (!( 'savings' in data ) || data.savings is number) &&
             (!( 'streak' in data ) || data.streak is number) &&
             (!( 'lastActive' in data ) || data.lastActive is timestamp);
    }

    function isValidProduct(data) {
      return hasRequiredFields(['title', 'price', 'category', 'sellerId', 'sellerName']) &&
             hasOnlyAllowedFields(['title', 'description', 'price', 'category', 'condition', 'isDigital', 'photoURL', 'sellerId', 'sellerName', 'createdAt', 'isSold', 'location', 'lat', 'lng']) &&
             data.title is string && data.title.size() > 0 && data.title.size() < 200 &&
             isValidOptionalString('description', 0, 5000) &&
             data.price is number && data.price >= 0 &&
             data.category is string && data.category.size() > 0 && data.category.size() < 100 &&
             isValidOptionalString('condition', 0, 100) &&
             (!( 'isDigital' in data ) || data.isDigital is bool) &&
             isValidOptionalString('photoURL', 0, 1000) &&
             data.sellerId == request.auth.uid &&
             data.sellerName is string && data.sellerName.size() > 0 && data.sellerName.size() < 100 &&
             (!( 'createdAt' in data ) || data.createdAt is timestamp) &&
             (!( 'isSold' in data ) || data.isSold is bool) &&
             (!( 'location' in data ) || data.location is string) &&
             (!( 'lat' in data ) || data.lat is number) &&
             (!( 'lng' in data ) || data.lng is number);
    }

    function isValidChat(data) {
      return hasRequiredFields(['participants', 'lastMessage', 'updatedAt', 'productId']) &&
             hasOnlyAllowedFields(['participants', 'lastMessage', 'updatedAt', 'productId']) &&
             data.participants is list && data.participants.size() == 2 &&
             request.auth.uid in data.participants &&
             data.lastMessage is string && data.lastMessage.size() >= 0 && data.lastMessage.size() < 1000 &&
             data.updatedAt is timestamp &&
             data.productId is string && data.productId.size() > 0 && data.productId.size() < 100;
    }

    function isValidMessage(data) {
      return hasRequiredFields(['chatId', 'senderId', 'text', 'createdAt']) &&
             hasOnlyAllowedFields(['chatId', 'senderId', 'text', 'createdAt']) &&
             data.chatId is string && data.chatId.size() > 0 && data.chatId.size() < 100 &&
             data.senderId == request.auth.uid &&
             data.text is string && data.text.size() > 0 && data.text.size() < 5000 &&
             data.createdAt is timestamp;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(request.resource.data) && 
                    (!('isVerified' in request.resource.data) || request.resource.data.isVerified == false);
      allow update: if isOwner(userId) && isValidUser(request.resource.data) && uidNotModified() &&
                    (!('isVerified' in request.resource.data) || request.resource.data.isVerified == resource.data.isVerified);
      allow delete: if isOwner(userId);
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidProduct(request.resource.data);
      allow update: if isAuthenticated() && request.auth.uid == resource.data.sellerId &&
                    isValidProduct(request.resource.data) &&
                    request.resource.data.sellerId == resource.data.sellerId; // Immutable sellerId
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.sellerId;
    }

    match /chats/{chatId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow create: if isAuthenticated() && isValidChat(request.resource.data);
      allow update: if isAuthenticated() && request.auth.uid in resource.data.participants &&
                    isValidChat(request.resource.data) &&
                    request.resource.data.participants == resource.data.participants && // Immutable participants
                    request.resource.data.productId == resource.data.productId; // Immutable productId
      allow delete: if isAuthenticated() && request.auth.uid in resource.data.participants;
      
      match /messages/{messageId} {
        allow read: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isAuthenticated() && 
                      request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
                      isValidMessage(request.resource.data) &&
                      request.resource.data.chatId == chatId;
        allow update: if false; // Messages are immutable
        allow delete: if false; // Messages cannot be deleted
      }
    }
  }
}
